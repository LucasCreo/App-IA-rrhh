# Config de producción — SOLO placeholders. El CI (sed) los reemplaza con las
# CI/CD vars scopeadas al environment ANTES del docker build. Sin secrets acá.

# Base de datos (Prisma)
DATABASE_URL=__DATABASE_URL__

# Auth propia (firma de sesión JWT) — REQUERIDA
JWT_SECRET=__JWT_SECRET__

# URL pública (server y cliente). Inlinada por Next en build → cambiar requiere rebuild.
NEXT_PUBLIC_APP_URL=__NEXT_PUBLIC_APP_URL__

# Email (SMTP) — opcional
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=__SMTP_PORT__
SMTP_USER=__SMTP_USER__
SMTP_PASS=__SMTP_PASS__
SMTP_FROM=__SMTP_FROM__

# Google OAuth (sincronización de calendario) — opcional
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__GOOGLE_CLIENT_SECRET__

# Aditus (almacenado de archivos vía Keycloak + Aditus platform) — REQUERIDAS
# Sin estas, todo upload/preview/delete de archivos falla.
ADITUS_TOKEN_URL=__ADITUS_TOKEN_URL__
ADITUS_CLIENT_ID=__ADITUS_CLIENT_ID__
ADITUS_USERNAME=__ADITUS_USERNAME__
ADITUS_PASSWORD=__ADITUS_PASSWORD__
ADITUS_BASE_URL=__ADITUS_BASE_URL__
ADITUS_LIBRARY_ID=__ADITUS_LIBRARY_ID__
ADITUS_OBJECT_DEFINITION_ID=__ADITUS_OBJECT_DEFINITION_ID__
