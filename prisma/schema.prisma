generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  username              String?   @unique
  passwordHash          String
  role                  String    @default("EMPLOYEE")
  employeeId            Int?      @unique
  managerUserId         Int?
  avatarUrl             String?
  avatarBgColor         String?
  avatarTextColor       String?
  googleRefreshToken    String?
  googleLastSync        DateTime?
  avisosLastSeenAt      DateTime?
  solicitudesLastSeenAt DateTime?
  createdAt             DateTime  @default(now())

  employee        Employee?            @relation(fields: [employeeId], references: [id])
  permisos        UserPermiso[]
  manager         User?                @relation("UserManager", fields: [managerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinados    User[]               @relation("UserManager")
  documents       Document[]           @relation("CargadoPor")
  auditLogs       AuditLog[]
  lotes           Lote[]               @relation("LotesCargados")
  eventosCreados  Evento[]             @relation("EventosCreadosPor")
  resetTokens     PasswordResetToken[]
  posts           Post[]               @relation("PostAutor")
  postReacciones  PostReaction[]       @relation("PostReactionUser")
  postComentarios PostComment[]        @relation("PostCommentAutor")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPermiso {
  userId  Int
  permiso String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permiso])
}

model Employee {
  id           Int      @id @default(autoincrement())
  legajo       String   @unique
  nombre       String
  apellido     String
  cuil         String   @unique
  email        String   @unique
  telefono     String?
  fechaIngreso DateTime
  categoriaId  Int
  estado       String   @default("ACTIVO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoria               Category                @relation(fields: [categoriaId], references: [id])
  user                    User?
  documents               Document[]
  valoresCampos           ValorCampoEmpleado[]
  solicitudes             SolicitudDocumento[]
  solicitudesModificacion SolicitudModificacion[]
  eventosAsignados        EventoEmpleado[]
  evaluaciones            Evaluacion[]
  respuestasFormulario    RespuestaFormulario[]
  ausencias               SolicitudAusencia[]
  saldosVacaciones        SaldoVacaciones[]
  lotes                   LoteEmpleado[]
}

model Category {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  employees Employee[]
  posts     Post[]
}

model Document {
  id              Int       @id @default(autoincrement())
  nombreArchivo   String
  filePath        String
  periodo         String?
  metadata        String?   @db.NVarChar(Max)
  fechaCarga      DateTime  @default(now())
  cargadoPorId    Int
  employeeId      Int
  tipoDocumentoId Int?
  estado          String    @default("BORRADOR")
  fechaFirma      DateTime?
  firmaConforme   Boolean?
  firmaComentario String?   @db.NVarChar(Max)
  updatedAt       DateTime  @updatedAt

  cargadoPor    User           @relation("CargadoPor", fields: [cargadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])
  lote          Lote?          @relation(fields: [loteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loteId        Int?
}

model Post {
  id          Int       @id @default(autoincrement())
  autorId     Int
  contenido   String    @db.NVarChar(Max)
  imagenUrl   String?
  alcance     String    @default("GLOBAL") // GLOBAL | CATEGORIA
  categoriaId Int?
  pinned      Boolean   @default(false)
  pinnedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  editedAt    DateTime?

  autor       User           @relation("PostAutor", fields: [autorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoria   Category?      @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reacciones  PostReaction[]
  comentarios PostComment[]
}

model PostReaction {
  postId    Int
  userId    Int
  tipo      String   @default("LIKE")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostReactionUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([postId, userId])
}

model PostComment {
  id              Int       @id @default(autoincrement())
  postId          Int
  autorId         Int
  contenido       String    @db.NVarChar(Max)
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  parentCommentId Int?

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor   User          @relation("PostCommentAutor", fields: [autorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent  PostComment?  @relation("PostCommentReplies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies PostComment[] @relation("PostCommentReplies")
}

model TipoDocumento {
  id           Int        @id @default(autoincrement())
  nombre       String     @unique
  descripcion  String?
  accion       String     @default("FIRMA")
  campos       String?    @db.NVarChar(Max)
  tienePeriodo Boolean    @default(true)
  protegido    Boolean    @default(false)
  documentos   Document[]
  lotes        Lote[]
  createdAt    DateTime   @default(now())
}

model Lote {
  id              Int      @id @default(autoincrement())
  nombre          String
  descripcion     String?
  periodo         String
  tipoDocumentoId Int?
  creadoPorId     Int
  createdAt       DateTime @default(now())

  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cargadoPor    User           @relation("LotesCargados", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentos    Document[]
  empleados     LoteEmpleado[]
}

model LoteEmpleado {
  loteId     Int
  employeeId Int

  lote     Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([loteId, employeeId])
}

model GeneralConfig {
  id                         Int      @id @default(autoincrement())
  appName                    String   @default("RRHH")
  logoUrl                    String?
  editWindowMin              Int      @default(1440)
  firmaMinSec                Int      @default(10)
  soporteEmail               String?
  soporteTel                 String?
  avisosEmpleadosHabilitados Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
}

model EmployeeFieldConfig {
  campo         String   @id
  visible       Boolean  @default(true)
  requerido     Boolean  @default(false)
  eliminado     Boolean  @default(false)
  visibleEnAlta Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model CampoPersonalizado {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  tipo          String   @default("texto")
  visible       Boolean  @default(true)
  requerido     Boolean  @default(false)
  visibleEnAlta Boolean  @default(true)
  orden         Int      @default(0)
  createdAt     DateTime @default(now())

  valores ValorCampoEmpleado[]

  @@map("campos_personalizados")
}

model ValorCampoEmpleado {
  id         Int    @id @default(autoincrement())
  employeeId Int
  campoId    Int
  valor      String

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  campo    CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([employeeId, campoId])
  @@map("valores_campo_empleado")
}

model EmailTemplate {
  key       String   @id
  subject   String   @db.NVarChar(500)
  title     String   @db.NVarChar(500)
  bodyHtml  String   @db.NVarChar(Max)
  ctaLabel  String?  @db.NVarChar(200)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model TipoSolicitud {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique
  descripcion        String?
  activo             Boolean  @default(true)
  requiereAprobacion Boolean  @default(true)
  campos             String   @default("[]") @db.NVarChar(Max)
  createdAt          DateTime @default(now())

  solicitudes SolicitudDocumento[]
}

model SolicitudDocumento {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  tipoId            Int
  nombreArchivo     String?  @db.NVarChar(Max)
  descripcion       String?
  metadata          String   @default("{}") @db.NVarChar(Max)
  estado            String   @default("PENDIENTE")
  comentario        String?
  comentarioVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo     TipoSolicitud @relation(fields: [tipoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SolicitudModificacion {
  id         Int      @id @default(autoincrement())
  employeeId Int
  comentario String
  estado     String   @default("PENDIENTE")
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Evento {
  id              Int       @id @default(autoincrement())
  titulo          String
  descripcion     String?
  fechaInicio     DateTime
  fechaFin        DateTime?
  todoElDia       Boolean   @default(true)
  tipo            String    @default("PERSONAL")
  subtipo         String?
  comentarioAdmin String?   @db.NVarChar(Max)
  googleEventId   String?
  creadoPorId     Int
  createdAt       DateTime  @default(now())

  creadoPor User             @relation("EventosCreadosPor", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asignados EventoEmpleado[]
}

model EventoEmpleado {
  eventoId   Int
  employeeId Int

  evento   Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([eventoId, employeeId])
}

model TipoEvento {
  id              Int      @id @default(autoincrement())
  nombre          String   @unique
  color           String   @default("#6b7280")
  permiteAdmin    Boolean  @default(true)
  permiteEmpleado Boolean  @default(false)
  protegido       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model PlantillaEvaluacion {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?  @db.NVarChar(Max)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  rondas    RondaEvaluacion[]
  criterios CriterioEvaluacion[]
}

model CriterioEvaluacion {
  id          Int    @id @default(autoincrement())
  plantillaId Int
  nombre      String
  label       String
  tipo        String
  orden       Int    @default(0)

  plantilla PlantillaEvaluacion @relation(fields: [plantillaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model RondaEvaluacion {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?  @db.NVarChar(Max)
  plantillaId Int
  estado      String   @default("ACTIVA")
  createdAt   DateTime @default(now())

  plantilla    PlantillaEvaluacion @relation(fields: [plantillaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evaluaciones Evaluacion[]
}

model Evaluacion {
  id         Int      @id @default(autoincrement())
  rondaId    Int
  employeeId Int
  resultados String   @default("{}") @db.NVarChar(Max)
  comentario String?  @db.NVarChar(Max)
  completada Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ronda    RondaEvaluacion @relation(fields: [rondaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([rondaId, employeeId])
}

model PlantillaFormulario {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  asignaciones AsignacionFormulario[]
  campos       CampoFormulario[]
}

model CampoFormulario {
  id          Int     @id @default(autoincrement())
  plantillaId Int
  nombre      String
  label       String
  tipo        String
  opciones    String?
  requerido   Boolean @default(false)
  rellena     String  @default("empleado")
  orden       Int     @default(0)

  plantilla PlantillaFormulario @relation(fields: [plantillaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AsignacionFormulario {
  id          Int       @id @default(autoincrement())
  nombre      String
  plantillaId Int
  fechaLimite DateTime?
  datosAdmin  String    @default("{}") @db.NVarChar(Max)
  createdAt   DateTime  @default(now())

  plantilla  PlantillaFormulario   @relation(fields: [plantillaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respuestas RespuestaFormulario[]
}

model RespuestaFormulario {
  id           Int      @id @default(autoincrement())
  asignacionId Int
  employeeId   Int
  datos        String   @default("{}") @db.NVarChar(Max)
  estado       String   @default("PENDIENTE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asignacion AsignacionFormulario @relation(fields: [asignacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([asignacionId, employeeId])
}

model TipoAusencia {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique
  color              String   @default("#6b7280")
  requiereAprobacion Boolean  @default(true)
  afectaSaldo        Boolean  @default(false)
  activo             Boolean  @default(true)
  protegido          Boolean  @default(false)
  createdAt          DateTime @default(now())

  solicitudes SolicitudAusencia[]
}

model SolicitudAusencia {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  tipoAusenciaId  Int
  fechaInicio     DateTime
  fechaFin        DateTime
  dias            Int
  motivo          String?  @db.NVarChar(Max)
  archivoUrl      String?  @db.NVarChar(500)
  estado          String   @default("PENDIENTE")
  comentarioAdmin String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipoAusencia TipoAusencia @relation(fields: [tipoAusenciaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SaldoVacaciones {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  anio        Int
  diasTotales Int      @default(14)
  diasUsados  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, anio])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  accion    String
  entidad   String
  detalle   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
