generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  role         String    @default("EMPLOYEE")
  rolId        Int?
  employeeId   Int?      @unique
  avatarUrl           String?
  googleRefreshToken  String?
  createdAt    DateTime  @default(now())

  rol       Rol?       @relation(fields: [rolId], references: [id])
  employee  Employee?  @relation(fields: [employeeId], references: [id])
  documents       Document[]  @relation("CargadoPor")
  auditLogs       AuditLog[]
  lotes           Lote[]      @relation("LotesCargados")
  eventosCreados  Evento[]    @relation("EventosCreadosPor")
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  createdAt   DateTime     @default(now())
  permisos    RolPermiso[]
  usuarios    User[]
}

model RolPermiso {
  rolId   Int
  permiso String
  rol     Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, permiso])
}

model Employee {
  id           Int       @id @default(autoincrement())
  legajo       String    @unique
  nombre       String
  apellido     String
  cuil         String    @unique
  email        String    @unique
  telefono     String?
  fechaIngreso DateTime
  categoriaId  Int
  estado       String    @default("ACTIVO")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  categoria       Category             @relation(fields: [categoriaId], references: [id])
  user            User?
  documents       Document[]
  valoresCampos   ValorCampoEmpleado[]
  solicitudes              SolicitudDocumento[]
  solicitudesModificacion  SolicitudModificacion[]
  eventosAsignados         EventoEmpleado[]
  evaluaciones             Evaluacion[]
  respuestasFormulario     RespuestaFormulario[]
}

model Category {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  employees Employee[]
}

model Document {
  id              Int       @id @default(autoincrement())
  nombreArchivo   String
  filePath        String
  periodo         String?
  metadata        String?
  fechaCarga      DateTime  @default(now())
  cargadoPorId    Int
  employeeId      Int
  tipoDocumentoId Int?
  estado          String    @default("BORRADOR")
  firmaExternalId String?
  fechaFirma      DateTime?
  updatedAt       DateTime  @updatedAt

  cargadoPor    User           @relation("CargadoPor", fields: [cargadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])
  lote          Lote?          @relation(fields: [loteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loteId        Int?
}

model TipoDocumento {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique
  descripcion   String?
  accion        String     @default("FIRMA")
  campos        String?
  tienePeriodo  Boolean    @default(true)
  protegido     Boolean    @default(false)
  documentos    Document[]
  lotes         Lote[]
  createdAt     DateTime   @default(now())
}

model Lote {
  id              Int      @id @default(autoincrement())
  nombre          String
  descripcion     String?
  periodo         String
  tipoDocumentoId Int?
  creadoPorId     Int
  createdAt       DateTime @default(now())

  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cargadoPor    User           @relation("LotesCargados", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentos    Document[]
}

model GeneralConfig {
  id        Int      @id @default(autoincrement())
  appName   String   @default("RRHH")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model EmployeeFieldConfig {
  campo     String   @id
  visible   Boolean  @default(true)
  requerido Boolean  @default(false)
  eliminado Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model CampoPersonalizado {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  tipo      String   @default("texto")
  visible   Boolean  @default(true)
  requerido Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  valores ValorCampoEmpleado[]

  @@map("campos_personalizados")
}

model ValorCampoEmpleado {
  id         Int    @id @default(autoincrement())
  employeeId Int
  campoId    Int
  valor      String

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  campo    CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([employeeId, campoId])
  @@map("valores_campo_empleado")
}

model SignatureConfig {
  id           Int      @id @default(autoincrement())
  providerUrl  String
  apiKey       String
  extraHeaders String   @default("{}")
  extraBody    String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model TipoSolicitud {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique
  descripcion        String?
  activo             Boolean  @default(true)
  requiereAprobacion Boolean  @default(true)
  campos             String   @default("[]")
  createdAt          DateTime @default(now())

  solicitudes SolicitudDocumento[]
}

model SolicitudDocumento {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  tipoId             Int
  nombreArchivo      String?
  descripcion        String?
  metadata           String   @default("{}")
  estado             String   @default("PENDIENTE")
  comentario         String?
  comentarioVisible  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo     TipoSolicitud @relation(fields: [tipoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SolicitudModificacion {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  comentario  String
  estado      String   @default("PENDIENTE")
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Evento {
  id              Int       @id @default(autoincrement())
  titulo          String
  descripcion     String?
  fechaInicio     DateTime
  fechaFin        DateTime?
  todoElDia       Boolean   @default(true)
  tipo            String    @default("PERSONAL")
  comentarioAdmin String?
  googleEventId   String?
  creadoPorId     Int
  createdAt       DateTime  @default(now())

  creadoPor User             @relation("EventosCreadosPor", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asignados EventoEmpleado[]
}

model EventoEmpleado {
  eventoId   Int
  employeeId Int

  evento   Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([eventoId, employeeId])
}

model TipoEvento {
  id              Int      @id @default(autoincrement())
  nombre          String   @unique
  color           String   @default("#6b7280")
  permiteAdmin    Boolean  @default(true)
  permiteEmpleado Boolean  @default(false)
  protegido       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model PlantillaEvaluacion {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  criterios   String   @default("[]")
  createdAt   DateTime @default(now())

  rondas RondaEvaluacion[]
}

model RondaEvaluacion {
  id          Int      @id @default(autoincrement())
  nombre      String
  plantillaId Int
  estado      String   @default("ACTIVA")
  createdAt   DateTime @default(now())

  plantilla    PlantillaEvaluacion @relation(fields: [plantillaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evaluaciones Evaluacion[]
}

model Evaluacion {
  id         Int      @id @default(autoincrement())
  rondaId    Int
  employeeId Int
  resultados String   @default("{}")
  comentario String?
  completada Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ronda    RondaEvaluacion @relation(fields: [rondaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([rondaId, employeeId])
}

model PlantillaFormulario {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  campos      String   @default("[]")
  createdAt   DateTime @default(now())

  asignaciones AsignacionFormulario[]
}

model AsignacionFormulario {
  id          Int       @id @default(autoincrement())
  nombre      String
  plantillaId Int
  fechaLimite DateTime?
  createdAt   DateTime  @default(now())

  plantilla  PlantillaFormulario  @relation(fields: [plantillaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respuestas RespuestaFormulario[]
}

model RespuestaFormulario {
  id           Int      @id @default(autoincrement())
  asignacionId Int
  employeeId   Int
  datos        String   @default("{}")
  estado       String   @default("PENDIENTE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asignacion AsignacionFormulario @relation(fields: [asignacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([asignacionId, employeeId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  accion    String
  entidad   String
  detalle   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
