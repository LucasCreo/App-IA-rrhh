generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  role         String    @default("EMPLOYEE")
  employeeId   Int?      @unique
  avatarUrl    String?
  createdAt    DateTime  @default(now())

  employee  Employee?  @relation(fields: [employeeId], references: [id])
  documents Document[] @relation("CargadoPor")
  auditLogs AuditLog[]
  lotes     Lote[]     @relation("LotesCargados")
}

model Employee {
  id           Int       @id @default(autoincrement())
  legajo       String    @unique
  nombre       String
  apellido     String
  cuil         String    @unique
  email        String    @unique
  telefono     String?
  fechaIngreso DateTime
  categoriaId  Int
  estado       String    @default("ACTIVO")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  categoria       Category             @relation(fields: [categoriaId], references: [id])
  user            User?
  documents       Document[]
  valoresCampos   ValorCampoEmpleado[]
  solicitudes              SolicitudDocumento[]
  solicitudesModificacion  SolicitudModificacion[]
}

model Category {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  employees Employee[]
}

model Document {
  id              Int       @id @default(autoincrement())
  nombreArchivo   String
  filePath        String
  periodo         String
  fechaCarga      DateTime  @default(now())
  cargadoPorId    Int
  employeeId      Int
  tipoDocumentoId Int?
  estado          String    @default("BORRADOR")
  firmaExternalId String?
  fechaFirma      DateTime?
  updatedAt       DateTime  @updatedAt

  cargadoPor    User           @relation("CargadoPor", fields: [cargadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])
  lote          Lote?          @relation(fields: [loteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loteId        Int?
}

model TipoDocumento {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  documentos  Document[]
  lotes       Lote[]
  createdAt   DateTime   @default(now())
}

model Lote {
  id              Int      @id @default(autoincrement())
  nombre          String
  descripcion     String?
  periodo         String
  tipoDocumentoId Int?
  creadoPorId     Int
  createdAt       DateTime @default(now())

  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cargadoPor    User           @relation("LotesCargados", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentos    Document[]
}

model GeneralConfig {
  id        Int      @id @default(autoincrement())
  appName   String   @default("RRHH")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model EmployeeFieldConfig {
  campo     String   @id
  visible   Boolean  @default(true)
  requerido Boolean  @default(false)
  eliminado Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model CampoPersonalizado {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  tipo      String   @default("texto")
  visible   Boolean  @default(true)
  requerido Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  valores ValorCampoEmpleado[]

  @@map("campos_personalizados")
}

model ValorCampoEmpleado {
  id         Int    @id @default(autoincrement())
  employeeId Int
  campoId    Int
  valor      String

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  campo    CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([employeeId, campoId])
  @@map("valores_campo_empleado")
}

model SignatureConfig {
  id           Int      @id @default(autoincrement())
  providerUrl  String
  apiKey       String
  extraHeaders String   @default("{}")
  extraBody    String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model TipoSolicitud {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  solicitudes SolicitudDocumento[]
}

model SolicitudDocumento {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  tipoId             Int
  nombreArchivo      String
  descripcion        String?
  estado             String   @default("PENDIENTE")
  comentario         String?
  comentarioVisible  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo     TipoSolicitud @relation(fields: [tipoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SolicitudModificacion {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  comentario  String
  estado      String   @default("PENDIENTE")
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  accion    String
  entidad   String
  detalle   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
